{
  "manifest": 1,
  "id": "winshun.web",
  "name": {"zh": "网页快捷搜索", "en": "Web shortcuts"},
  "version": "1.0.0",
  "description": {"zh": "零代码示例：bd 百度、gh GitHub、yt YouTube、wiki 维基百科、bing 必应、bili 哔哩哔哩", "en": "Zero-code sample: bd Baidu, gh GitHub, yt YouTube, wiki Wikipedia, bing, bili"},
  "author": "LingCore",
  "homepage": "https://github.com/LingCore/WinShun",
  "license": "MIT",
  "commands": [
    {"id": "bd", "keyword": "bd", "title": {"zh": "百度", "en": "Baidu"}, "icon": "glyph:U+E774", "hint": {"zh": "要搜的词", "en": "words to search"}, "run": {"url": "https://www.baidu.com/s?wd=%s", "home": "https://www.baidu.com/"}},
    {"id": "gh", "keyword": "gh", "title": "GitHub", "icon": "glyph:U+E943", "hint": {"zh": "仓库或代码", "en": "repositories or code"}, "run": {"url": "https://github.com/search?q=%s", "home": "https://github.com/"}},
    {"id": "yt", "keyword": "yt", "title": "YouTube", "icon": "glyph:U+E714", "hint": {"zh": "视频", "en": "videos"}, "run": {"url": "https://www.youtube.com/results?search_query=%s", "home": "https://www.youtube.com/"}},
    {"id": "wiki", "keyword": "wiki", "title": {"zh": "维基百科", "en": "Wikipedia"}, "icon": "glyph:U+E736", "hint": {"zh": "条目", "en": "an article"}, "run": {"url": "https://zh.wikipedia.org/w/index.php?search=%s", "home": "https://zh.wikipedia.org/"}},
    {"id": "bing", "keyword": "bing", "title": {"zh": "必应", "en": "Bing"}, "icon": "glyph:U+E721", "run": {"url": "https://www.bing.com/search?q=%s", "home": "https://www.bing.com/"}},
    {"id": "bili", "keyword": "bili", "title": {"zh": "哔哩哔哩", "en": "Bilibili"}, "icon": "glyph:U+E714", "hint": {"zh": "视频或 UP 主", "en": "videos"}, "run": {"url": "https://search.bilibili.com/all?keyword=%s", "home": "https://www.bilibili.com/"}}
  ]
}
